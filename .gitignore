# Swift / SPM
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj/
xcuserdata/
DerivedData/

# Build output
build/

# macOS
.DS_Store

# Claude Code
.claude/hooks/
.claude/logs/
.claude/settings.local.json
.claude/worktrees/

# Temporary files
tmp/

# Logs (generated artifacts)
*.log

# CAWS-generated local state. Kept outside the managed block below
# so `caws init` does not clobber these. Hooks are batch-installed by
# the tooling; working-spec scratch files are ephemeral.
.caws/hooks/
.caws/working-spec*.yaml

# >>> caws gitignore (managed, v2) >>>
# Ephemeral CAWS runtime/local state — never tracked. Authority state
# (.caws/specs/, .caws/policy.yaml, .caws/waivers/) is intentionally NOT
# listed here so it stays versioned. Managed by `caws init`; edits inside
# these markers are overwritten on the next init.
.caws/worktrees/
.caws/worktrees.json
.caws/agents.json
.caws/leases/
.caws/cache/
.caws/sessions/
.caws/state/
.caws/duplication-cache.json
.caws/events.jsonl
.caws/events.jsonl.lock
tmp/guard-strikes-*.json
# <<< caws gitignore <<<
